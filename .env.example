# RAKSHA-SETU (रक्षा-सेतु) API KEYS & CONFIGURATION
# Smart India Hackathon 2026 • Team Mavericks

# ----------------------------------------------------------------------------
# 1. Google Gemini AI API Key (Optional but recommended)
# Enables real-time Generative AI hazard evaluation and automated NDMA advisories.
# Get free key at: https://aistudio.google.com/app/apikey
# ----------------------------------------------------------------------------
VITE_GEMINI_API_KEY=

# ----------------------------------------------------------------------------
# 2. OpenWeatherMap API Key (Optional)
# If left blank, the app automatically uses Open-Meteo (FREE, ZERO KEY NEEDED)
# Get key at: https://openweathermap.org/api
# ----------------------------------------------------------------------------
VITE_OPENWEATHER_API_KEY=

# ----------------------------------------------------------------------------
# 3. Mapbox Public Access Token (Optional)
# If left blank, the app automatically uses CartoDB & OpenStreetMap tiles.
# Get key at: https://account.mapbox.com/
# ----------------------------------------------------------------------------
VITE_MAPBOX_TOKEN=

# ----------------------------------------------------------------------------
# 4. Emergency SMS Gateway (Fast2SMS / Twilio) (Optional)
# Used for testing real multi-channel citizen SMS broadcast
# ----------------------------------------------------------------------------
VITE_SMS_API_KEY=
